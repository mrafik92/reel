<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/setup_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginBottom="24dp"
            android:contentDescription="@null"
            android:src="@drawable/logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/setup_heading"
            android:textColor="@color/ink"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:maxWidth="480dp"
            android:text="@string/setup_hint_text"
            android:textColor="@color/muted"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/server_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:autofillHints="url"
            android:hint="@string/setup_input_hint"
            android:imeOptions="actionGo"
            android:importantForAutofill="yes"
            android:inputType="textUri"
            android:maxWidth="480dp"
            android:minHeight="48dp"
            android:singleLine="true"
            android:textColor="@color/ink"
            android:textColorHint="@color/muted" />

        <Button
            android:id="@+id/connect"
            style="@style/Widget.ReelWeb.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/setup_connect" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:maxWidth="480dp"
            android:textColor="@color/muted"
            android:textSize="15sp" />

        <Button
            android:id="@+id/save_anyway"
            style="@style/Widget.ReelWeb.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/setup_save_anyway"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
