<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- The page and its native panels; padded by the system bars, cutout and keyboard (Insets.kt). -->
    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- The WebView is created in code (MainActivity) so it can be replaced after a renderer crash. -->
        <FrameLayout
            android:id="@+id/web_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/progress"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:indeterminate="false"
            android:max="100"
            android:progressTint="@color/tile"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/error_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginBottom="24dp"
                android:contentDescription="@null"
                android:src="@drawable/logo" />

            <TextView
                android:id="@+id/error_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/ink"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/error_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:maxWidth="480dp"
                android:textColor="@color/muted"
                android:textSize="16sp" />

            <!-- The raw error (net::ERR_…, HTTP 502) for whoever debugs it; the message above is the plain one. -->
            <TextView
                android:id="@+id/error_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/muted"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Automatic retry: "Trying again in 4 s", "Waiting for a network connection". -->
            <TextView
                android:id="@+id/error_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:minWidth="160dp"
                android:text="@string/retry" />

            <Button
                android:id="@+id/change_server"
                style="@android:style/Widget.Material.Button.Borderless.Colored"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/change_server" />
        </LinearLayout>
    </FrameLayout>

    <!-- Full-screen video (#227): WebChromeClient.onShowCustomView puts its view here, edge to edge
         with the system bars hidden. Not padded, so the picture uses the whole screen. -->
    <FrameLayout
        android:id="@+id/full_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:visibility="gone" />
</FrameLayout>
