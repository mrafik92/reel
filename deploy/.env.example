# Copy to `.env` next to docker-compose.yml.

# Where your media lives on the host (mounted read-only at /media; point libraries at /media/…)
MEDIA_DIR=/srv/media

# Metadata (optional). Without a TMDB key Reel still reads local .nfo files and artwork.
REEL_TMDB_API_KEY=

# Radarr/Sonarr webhook secret — pick a long random string, e.g. `openssl rand -hex 24`
REEL_WEBHOOK_SECRET=

# Public address (used in invite links)
REEL_PUBLIC_URL=http://localhost:8420

# GPU groups on the host (so the non-root container user can open /dev/dri/renderD128)
#   getent group render | cut -d: -f3      getent group video | cut -d: -f3
RENDER_GID=105
VIDEO_GID=44

TZ=UTC

# ── HTTPS with the bundled Caddy (docker compose --profile caddy up -d) ──
#REEL_DOMAIN=reel.example.com
#ACME_EMAIL=you@example.com
# When Caddy fronts Reel: only expose Reel on loopback and trust the proxy's client-IP headers
#REEL_BIND_HOST=127.0.0.1
#REEL_TRUST_PROXY_HEADERS=true
#REEL_PUBLIC_URL=https://reel.example.com

# ── Hardening / limits (defaults shown) ──
#REEL_ALLOW_PRIVATE_FETCH=true        # IPTV playlists/EPG/streams on the LAN allowed
#REEL_ALLOW_PRIVATE_LOGO_FETCH=false  # channel logos from private addresses blocked
#REEL_MAX_TRANSCODES=0
#REEL_MAX_USER_TRANSCODES=0
